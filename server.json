{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.mfdaves/okf-mcp",
  "title": "okf-mcp",
  "description": "Validate, search, graph, and safely author local Open Knowledge Format bundles.",
  "repository": {
    "url": "https://github.com/mfdaves/okf-mcp",
    "source": "github"
  },
  "websiteUrl": "https://github.com/mfdaves/okf-mcp#readme",
  "version": "0.8.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@mfdaves/okf-mcp",
      "version": "0.8.1",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "named",
          "name": "--root",
          "description": "Absolute path to one OKF bundle root.",
          "isRequired": true,
          "format": "filepath",
          "placeholder": "/absolute/path/to/okf-root"
        },
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
