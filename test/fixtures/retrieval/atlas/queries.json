{
  "version": 1,
  "description": "Retrieval evaluation queries for an architecture-catalog agent over the Tessera 'atlas' OKF bundle (+ shared engineering standards). Second-domain fixture for agent-agnosticism (WP0). Graded relevance: 2 = must appear, 1 = acceptable. distractors are near-duplicates that should rank BELOW the grade-2 concept. All queries were written from the generated text before any search run (added: wp0). split is the seeded 70/30 dev/heldout assignment stratified by category x lang; the plan gates this fixture on its full set until it reaches 150 queries. sectionAnchor marks queries whose answer lives in one section of one concept (WP3a).",
  "as_of": "2026-10-24",
  "categories": {
    "nl-task": "Natural-language task sentence, as an engineering agent would phrase a question mid-task",
    "keyword": "Short keyword query (1-3 content words)",
    "mixed-lang": "Query mixing Italian and English terms",
    "exact": "Exact-string lookup: incident key, ADR number, topic, hostname, error code, path",
    "morph": "Morphological variant of indexed words (singular/plural, verb forms)",
    "accent": "Accent variant: query without the accent the text has (or control with accent)",
    "synonym": "Paraphrase using words that do not occur in the relevant text",
    "freshness": "Current concept expected above a deprecated or superseded twin",
    "disambig": "Near-duplicate disambiguation by version, language, sibling or type",
    "standards": "Expected concept lives in the shared standards bundle (project mode only)",
    "no-answer": "Plausible agent question with no relevant concept; the system should return nothing or score low"
  },
