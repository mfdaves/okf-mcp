    "nl-task": "Natural-language task sentence, as the agent would phrase a question mid-task",
    "keyword": "Short keyword query (1-3 content words)",
    "mixed-lang": "Query mixing Italian and English terms",
    "exact": "Exact-string lookup: SKU, URL path, brand/competitor term, technical token",
    "morph": "Morphological variant of indexed words (singular/plural, noun/verb)",
    "accent": "Accent variant: query without the accent the text has (or control with accent)",
    "synonym": "Paraphrase using synonyms that do not occur in the relevant text",
    "freshness": "Fresh/verified concept expected above a stale or superseded twin",
    "disambig": "Near-duplicate disambiguation by intent or language",
    "playbook": "Expected concept lives in the shared playbook bundle (project mode only)",
    "no-answer": "Plausible agent question with no relevant concept; the system should return nothing or score low"
  },
